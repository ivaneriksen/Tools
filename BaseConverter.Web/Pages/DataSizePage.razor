@page "/data-size"
@using System.Globalization

<PageTitle>Data Size Converter</PageTitle>

<h1 class="fs-3">Data Size Converter</h1>


<div class="row">
    <div class="col-lg-6">

        <div class="card mb-3">
            <div class="card-body p-3">
                <div class="row g-2 align-items-center">
                    <div class="col-auto">
                        <input type="number" class="form-control" style="width: 12rem" onfocus="this.select()"
                               @bind="amount" @bind:event="oninput" @bind:after="Update"
                               onkeydown="if (event.key.length === 1 && !/[0-9.]/.test(event.key)) event.preventDefault();" />
                    </div>
                    <div class="col-auto">
                        <select class="form-select" @bind="selectedUnitName" @bind:after="Update">
                            @foreach (DataUnit unit in DataSizeConverter.AllUnits)
                            {
                                <option value="@unit.Name">@unit.Name</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
        </div>

        @if (errorMessage != null)
        {
            <div class="alert alert-danger">@errorMessage</div>
        }

        @foreach (var group in results.GroupBy(r => r.Unit.Group))
        {
            <div class="group-label">@group.Key</div>

            <div class="row row-cols-2 g-2">
                @foreach (DataSize size in group)
                {
                    <div class="col">
                        <div class="unit-box d-flex justify-content-between">
                            <span class="text-secondary">@size.Unit.Name</span>
                            <span>@Format(size.Amount)</span>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>


@code {
    private decimal amount = 1000;
    private string selectedUnitName = "kB";
    private DataSize[] results = [];
    private string? errorMessage = null;


    // Initialize the component and perform the initial conversion.
    protected override void OnInitialized()
    {
        Update();
    }


    // Update the conversion results based on the current amount and selected unit.
    private void Update()
    {
        try 
        {
            DataUnit dataUnit = DataSizeConverter.AllUnits.First(u => u.Name == selectedUnitName);
            results = DataSizeConverter.ConvertToAll(amount, dataUnit);
            errorMessage = null;
        }
        catch (ArgumentOutOfRangeException ex)
        {
            results = [];
            errorMessage = ex.Message;
        }
        catch (OverflowException)
        {
            results = [];
            errorMessage = "The amount is too large to convert.";
        }
        catch (Exception ex)
        {
            results = [];
            errorMessage = "An unexpected error occurred: " + ex.Message;
        }
    }

    // Format the decimal value for display, using < 0.000001 for very small values.
    private static string Format(decimal value)
    {
        if (value > 0 && value < 0.000001m)
        {
            return "< 0.000001";
        }

        return value.ToString("#,##0.######", CultureInfo.InvariantCulture);
    }

}