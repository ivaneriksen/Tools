@page "/"

<PageTitle>Tools</PageTitle>

<h1>Tools</h1>
<p class="text-secondary mb-4">Small tools for class. Pick one below or from the menu.</p>

<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
    <div class="col">
        <div class="card tool-card h-100">
            <div class="card-body p-4">
                <h5 class="card-title">Base Converter</h5>
                <p class="card-text text-secondary">
                    Convert numbers between any bases from 2 to 36.
                </p>
                <a href="base-converter" class="stretched-link"></a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card tool-card h-100">
            <div class="card-body p-4">
                <h5 class="card-title">Data Size Converter</h5>
                <p class="card-text text-secondary">
                    Convert data sizes between different units.
                </p>
                <a href="data-size" class="stretched-link"></a>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card tool-card h-100">
            <div class="card-body p-4">
                <h5 class="card-title">IPv6 Formatter</h5>
                <p class="card-text text-secondary">
                    Convert IPv6 addresses between full and compressed forms.
                </p>
                <a href="ipv6" class="stretched-link"></a>
            </div>
        </div>
    </div>
</div>